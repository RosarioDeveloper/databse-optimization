POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=database_optimization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

OTEL_SERVICE_NAME=api-optimization
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_RESOURCE_ATTRIBUTES=service.namespace=api-optimization-group,deployment.environment=development,deployment.environment.name=development

GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-6.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
GRAFANA_CLOUD_BASIC_AUTH_HEADER="Basic <BASE64_INSTANCE_ID_API_KEY>"
